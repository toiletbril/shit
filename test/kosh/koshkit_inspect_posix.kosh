root=$(mktemp -d)
cd "$root"

: > empty
printf 'hello\n' > text
printf '\0abcde\0xy\n' > binary

koshkit file empty text binary
koshkit file -i empty text
koshkit ln -s text text-link
koshkit ln -s absent broken-link
koshkit file text-link
koshkit file -h text-link broken-link
(koshkit file absent) 2> "$TEST_NULL_DEVICE"
echo "file-missing=$?"
printf '%s\n' '0 string \x97\x4A\x42\x32 image data' > magic-a
printf '%s\n' '0 string \x97 fallback data' > magic-b
printf '%s\n' '0 string no no-match' > magic-zero
printf '\227JB2' > magic-data
koshkit file -M magic-a magic-data
koshkit file -M magic-a -m magic-b magic-data
koshkit file -M magic-zero -m magic-b -M magic-a magic-data
printf '%s\n' '0 uC <10 small' '0 uC >10 large' > magic-number
printf '\005' > magic-low
printf '\024' > magic-high
koshkit file -M magic-number magic-low magic-high
printf '%s\n' '0 uC&0x0f 5 masked' > magic-mask
printf '\025' > magic-masked
koshkit file -M magic-mask magic-masked
printf '%s\n' '0 uC 5 value-is-%d' > magic-format
koshkit file -M magic-format magic-low
printf '%s\n' '0 uC 1 parent' '>1 uC &0x80 child' > magic-continuation
printf '\001\200' > magic-child
koshkit file -M magic-continuation magic-child
printf '%s\n' 'invalid line' '0 string hello greeting' > magic-malformed
printf hello > magic-hello
koshkit file -M magic-malformed magic-hello

format_rows='png|\211PNG\r\n\032\n
jpeg|\377\330\377
gzip|\037\213
xz|\3757zXZ\0
zip|PK\003\004
pdf|%PDF-
sqlite|SQLite format 3\0
wasm|\0asm
llvm|BC\300\336
java|\312\376\272\276\0\0\0\075
universal|\312\376\272\276\0\0\0\001
webp|RIFF\0\0\0\0WEBP
avif|\0\0\0\0ftypavif
matroska|\032E\337\243matroska
flac|fLaC
ogg|OggS
midi|MThd\0\0\0\006
postgres|PGDMP
git-pack|PACK
flash|FWS'
old_ifs=$IFS
IFS='
'
for format_row in $format_rows; do
  format_name=${format_row%%|*}
  format_bytes=${format_row#*|}
  printf '%b' "$format_bytes" > "$format_name"
done
IFS=$old_ifs
koshkit file png jpeg gzip xz zip pdf sqlite wasm llvm java universal webp \
  avif matroska flac ogg midi postgres git-pack flash

koshkit strings binary
koshkit strings -n 2 -t d binary
koshkit od -An -tx1 text
koshkit od -An -tc text
printf '1234567890abcdef1234567890abcdef' > repeated
koshkit od -A n -t x1 repeated
koshkit od -v -A n -t x1 repeated
printf '\1\2\3\4\5\6\7\10' > od-types
koshkit od -A n -t c -t d -t o -t u -t x -t d1 -t d2 -t d4 -t d8 od-types
koshkit od text +1
koshkit od text +1.
koshkit od text +0b
koshkit od text 1
(koshkit od -A n text +1) > "$TEST_NULL_DEVICE" 2>&1
echo "od-modern-plus-file=$?"
printf 'abcdef' | koshkit od -A n -t c -j 0k -N 0x4
printf 'abcdef' | koshkit od -A n -t c -j 00b -N 04
printf 'abcdefghijklmnop' | koshkit od -A n -t c -j 0xb -N 1
printf '\377\200\177\0' > od-signed
koshkit od -A n -t dC od-signed
(koshkit od -A n -t dS -t dI -t dL od-signed) > "$TEST_NULL_DEVICE"
echo "od-symbolic-widths=$?"
