#!/usr/bin/env kosh
echo "== DEBUG =="
trap 'echo "D-$?"' DEBUG
echo one
false
echo "rc=$?"
trap - DEBUG
echo "== ERR =="
trap 'echo E' ERR
false
true
trap - ERR
echo "== RETURN =="
f() { echo body; return 7; }
trap 'echo R' RETURN
f
echo "rc=$?"
trap - RETURN
echo "== RETURN SOURCE =="
source_file=$TEST_TEMP_DIRECTORY/kosh-return-source-$$
printf 'echo sourced-body\nfalse\nreturn 3\n' > "$source_file"
trap 'echo "R-source-$?"' RETURN
. "$source_file"
echo "rc=$?"
trap - RETURN
koshkit unlink "$source_file"
echo "== GUARDED LOOP =="
set --mood bash
trap 'echo unexpected' ERR
for item in one two; do
  false && echo unreachable
done
echo "rc=$?"
trap - ERR
set --mood kosh
echo "mood=$(set --mood)"
echo "== DONE =="
