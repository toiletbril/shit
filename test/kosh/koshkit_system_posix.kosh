koshkit cal 2 2024
cal_today=$(koshkit cal -a 2 2024)
printf '%s\n' "$cal_today" |
  koshkit grep '^Mo Tu We Th Fr Sa Su$' >/dev/null
echo "cal-monday-first=$?"
printf '%s\n' "$cal_today" |
  koshkit grep '^Today is .*[.] It is day [0-9][0-9]* of the year[.]$' >/dev/null
echo "cal-today-description=$?"
koshkit cal 1 9223372036854775807 >/dev/null
echo "cal-large-year=$?"

koshkit date -u +%Y >/dev/null
echo "date=$?"
koshkit getconf ARG_MAX >/dev/null
echo "getconf=$?"
koshkit id -u >/dev/null
echo "id=$?"
LC_ALL=C koshkit locale charmap >/dev/null
echo "locale=$?"
LC_ALL=C koshkit locale -ck decimal_point
LC_ALL=C koshkit locale -c charmap
LOGNAME=spoofed USER=spoofed koshkit logname >/dev/null
echo "logname-unspoofed=$?"
koshkit tty -s
echo "tty=$?"
koshkit uname -s >/dev/null
echo "uname=$?"
koshkit who >/dev/null
echo "who=$?"
koshkit who -Hq >/dev/null
echo "who-quick=$?"
koshkit who -m >/dev/null
echo "who-current=$?"
koshkit who -Tu >/dev/null
echo "who-state=$?"
