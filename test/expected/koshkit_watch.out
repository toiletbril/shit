[CompoundList]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "watch"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "missing-command=$?"]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "watch"
]
[Word
  Unquoted "2"
]
[Word
  Variable "TEST_NULL_DEVICE"
]
[Word
  Unquoted "echo"
]
[Word
  DoubleQuoted "missing-command="
  Variable "?"
]
missing-command=2
