[CompoundList]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "evilnet" "extra"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "unexpected-operand=$?"]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "evilnet"
]
[Word
  Unquoted "extra"
]
[Word
  Unquoted "2"
]
[Word
  Variable "TEST_NULL_DEVICE"
]
[Word
  Unquoted "echo"
]
[Word
  DoubleQuoted "unexpected-operand="
  Variable "?"
]
unexpected-operand=1
