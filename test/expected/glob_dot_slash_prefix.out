[CompoundList]
  [CompoundListCondition, None]
    [Assign start=$PWD]
  [CompoundListCondition, None]
    [Assign directory=$TEST_TEMP_DIRECTORY/glob-dot-slash]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "rm" "-rf" "$directory"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$directory/real/nested"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "real" "$directory/linked"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "missing" "$directory/broken"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$directory"]
  [CompoundListCondition, &&]
    [SimpleCommand ":"]
  [CompoundListCondition, &&]
    [SimpleCommand ":"]
  [CompoundListCondition, &&]
    [SimpleCommand ":"]
  [CompoundListCondition, &&]
    [SimpleCommand "echo" "./*.sh"]
  [CompoundListCondition, &&]
    [SimpleCommand "echo" "*.sh"]
  [CompoundListCondition, &&]
    [SimpleCommand "echo" "*/nested"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$start"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "rm" "-rf" "$directory"]
[Word
  Unquoted "start="
  Variable "PWD"
]
[Word
  Unquoted "directory="
  Variable "TEST_TEMP_DIRECTORY"
  Unquoted "/glob-dot-slash"
]
