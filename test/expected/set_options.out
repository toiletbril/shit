[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "set" "-o" "pipefail"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "on=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "+o" "pipefail"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "off=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--" "one" "two" "three"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$1 $3 count=$#"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--mood" "--" "mood-marker"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "mood=$(set --mood) args=$*"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--init-moods" "--" "init-marker"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "init=$*"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--tab-selector" "--" "selector-marker"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "selector=$(set --tab-selector) args=$*"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "set" "-euo" "pipefail"]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "bundled=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "-Z"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bad=$?"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "set" "-e"]
        [CompoundListCondition, None]
          [SimpleCommand "false"]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "notreached"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "after=$?"]
