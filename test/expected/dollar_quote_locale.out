[CompoundList]
  [CompoundListCondition, None]
    [Assign x=world]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "[%s]\n" "plain"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "[%s]\n" "hello $x"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "premidpost"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "a $"]
  [CompoundListCondition, None]
    [SimpleCommand "$BIN" "--mood" "posix" "--no-annoying-diagnostics" "-c" "printf "[%s]\n" $"posix locale"; printf "[%s]\n" pre$"mid"post"]
  [CompoundListCondition, None]
    [SimpleCommand "$BIN" "--mood" "posix" "--no-annoying-diagnostics" "-c" "printf "[%s]\n" "${x:-$"posix modifier"}""]
  [CompoundListCondition, None]
    [Assign doubled_locale=$$tail]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "[%s]\n" "$doubled_locale#$$"]
  [CompoundListCondition, None]
    [Assign doubled_ansi=$$a\tb]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "[%s]\n" "$doubled_ansi#$$"]
  [CompoundListCondition, None]
    [Assign tripled_ansi=$$a	b]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "[%s]\n" "$tripled_ansi#$$"]
[Word
  Unquoted "x=world"
]
[Word
  Unquoted "printf"
]
