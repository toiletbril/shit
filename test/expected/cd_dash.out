[CompoundList]
  [CompoundListCondition, None]
    [Assign start=$PWD]
  [CompoundListCondition, None]
    [SimpleCommand "shitbox" "mkdir" "-p" "$TEST_TEMP_DIRECTORY/cd-dash/first" "$TEST_TEMP_DIRECTORY/cd-dash/second"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$TEST_TEMP_DIRECTORY/cd-dash/first"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "../second"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "-"]
  [CompoundListCondition, None]
    [SimpleCommand "shitbox" "basename" "$PWD"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "PWD=$(shitbox basename "$PWD") OLDPWD=$(shitbox basename "$OLDPWD")"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "-"]
  [CompoundListCondition, None]
    [SimpleCommand "shitbox" "basename" "$PWD"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$start"]
[Word
  Unquoted "start="
  Variable "PWD"
]
