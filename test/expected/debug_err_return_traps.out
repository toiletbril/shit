[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== DEBUG =="]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo "D-$?"" "DEBUG"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "one"]
  [CompoundListCondition, None]
    [SimpleCommand "false"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-" "DEBUG"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== ERR =="]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo E" "ERR"]
  [CompoundListCondition, None]
    [SimpleCommand "false"]
  [CompoundListCondition, None]
    [SimpleCommand "true"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-" "ERR"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== RETURN =="]
  [CompoundListCondition, None]
    [FunctionDefinition "f"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "body"]
          [CompoundListCondition, None]
            [SimpleCommand "return" "7"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo R" "RETURN"]
  [CompoundListCondition, None]
    [SimpleCommand "f"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-" "RETURN"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== RETURN SOURCE =="]
  [CompoundListCondition, None]
    [Assign source_file=$TEST_TEMP_DIRECTORY/kosh-return-source-$$]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "echo sourced-body\nfalse\nreturn 3\n"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo "R-source-$?"" "RETURN"]
  [CompoundListCondition, None]
    [SimpleCommand "." "$source_file"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-" "RETURN"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$source_file"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== GUARDED LOOP =="]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--mood" "bash"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo unexpected" "ERR"]
  [CompoundListCondition, None]
    [ForLoop "item"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "false"]
        [CompoundListCondition, &&]
          [SimpleCommand "echo" "unreachable"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-" "ERR"]
