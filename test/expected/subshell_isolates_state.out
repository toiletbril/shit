[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "shitbox" "mkdir" "-p" "$TEST_TEMP_DIRECTORY/subshell-state"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "inside"]
        [CompoundListCondition, None]
          [SimpleCommand "cd" "$TEST_TEMP_DIRECTORY/subshell-state"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "outside"]
