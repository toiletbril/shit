[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$TEST_TEMP_DIRECTORY"]
  [CompoundListCondition, None]
    [Assign dyn_file=$TEST_TEMP_DIRECTORY/redirect-dynamic-fd]
  [CompoundListCondition, None]
    [Assign err_file=$TEST_TEMP_DIRECTORY/redirect-dynamic-fd-error]
  [CompoundListCondition, None]
    [Assign fd=5]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "dyn-builtin"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "lit-builtin"]
          [CompoundListCondition, None]
            [SimpleCommand "/bin/echo" "dyn-extern"]
  [CompoundListCondition, None]
    [SimpleCommand "cat" "$dyn_file"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "separator"]
  [CompoundListCondition, None]
    [Assign errfd=2]
  [CompoundListCondition, None]
    [SimpleCommand "/bin/echo" "to-stderr"]
  [CompoundListCondition, None]
    [SimpleCommand "cat" "$err_file"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$dyn_file"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$err_file"]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "mkdir"
]
[Word
  Unquoted "-p"
]
[Word
  Variable "TEST_TEMP_DIRECTORY"
]
