[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "retry" "-n" "2" "-d" "0" "-q" "printf" "retry-ok"]
  [CompoundListCondition, None]
    [SimpleCommand "echo"]
  [CompoundListCondition, None]
    [Assign attempt=0]
  [CompoundListCondition, None]
    [FunctionDefinition "retry_once"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [Assign attempt=$((attempt + 1))]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$attempt" "-eq" "2" "]"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "retry" "-n" "2" "-d" "0" "retry_once"]
