[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "one\ntwo\nthree\nfour\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "lines" "3"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "xx00" "xx01"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\nmark\nb\nmark\nc\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "piece" "repeated" "/mark/" "{1}"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "piece00" "piece01" "piece02"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "offset" "repeated" "/mark/+1"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "offset00" "offset01"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "csplit" "-s" "-f" "rejected" "repeated" "3" "99"]
  [CompoundListCondition, None]
    [SimpleCommand "test" "!" "-e" "rejected00"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-cleanup=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a/b\nnext\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "slash" "slash-input" "/a\/b/"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "slash00" "slash01"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "zero" "a%b" "end"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "percent" "percent-input" "%a\%b%"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "percent00"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "one\nmark\nmark\nend\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "regex" "regex-input" "/mark/" "/mark/"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "regex00" "regex01" "regex02"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "hit\nend\n"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "csplit" "-s" "-f" "first-line" "first-line-input" "1" "/hit/"]
  [CompoundListCondition, None]
    [SimpleCommand "test" "!" "-e" "first-line00"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-first-line-clean=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\nb\nmark\nc\nd\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "offset-minus" "offset-input" "/mark/-1"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "offset-minus00" "offset-minus01"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "offset-plus" "offset-input" "/mark/+1"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "offset-plus00" "offset-plus01"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "offset-unsigned" "offset-input" "/mark/1"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "offset-unsigned00" "offset-unsigned01"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "seq" "1" "21"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "csplit" "-k" "-s" "-n" "1" "-f" "width" "width-input" "2" "{9}"]
  [CompoundListCondition, None]
    [SimpleCommand "test" "-e" "width0"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-width-first=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "test" "-e" "width9"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-width-last=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "test" "!" "-e" "width10"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-width-exhausted=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "zero-repeat" "lines" "3" "{0}"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-zero-repeat=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "star-repeat" "width-input" "2" "{*}"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-star-repeat=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\nmark\nend\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "stagnant" "stagnant-input" "/mark/-1" "{*}"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "stagnant00" "stagnant01"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "csplit" "-s" "lines" "{1}"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "csplit" "-s" "-f" "consecutive" "lines" "3" "{0}" "{0}"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "csplit" "-s" "lines" "/one/+999999999999999999999"]
  [CompoundListCondition, None]
    [Assign name_limit=$(koshkit getconf NAME_MAX .)]
  [CompoundListCondition, None]
    [Assign long_prefix=]
  [CompoundListCondition, None]
    [Assign prefix_index=0]
  [CompoundListCondition, None]
    [WhileLoop]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "[" "$prefix_index" "-lt" "$name_limit" "]"]
      [CompoundList]
        [CompoundListCondition, None]
          [Assign long_prefix=$long_prefixx]
        [CompoundListCondition, None]
          [Assign prefix_index=$((prefix_index + 1))]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "csplit" "-s" "-n" "1" "-f" "$long_prefix" "lines" "3"]
  [CompoundListCondition, None]
    [SimpleCommand "test" "!" "-e" "$long_prefix0"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-name-limit-clean=$?"]
