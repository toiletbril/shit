apple
--- sort ---
apple
apple
banana
cherry
--- sort -r ---
cherry
banana
apple
apple
--- sort then uniq -c ---
      2 apple
      1 banana
      1 cherry
--- sort multiple files with a missing operand ---
1:1: error: sort: cannot read 'missing.txt': No such file or directory.
     1 |  koshkit sort sort-a.txt missing.txt sort-b.txt; printf "status=%s\n" "$?"
       |  ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
alpha
beta
middle
zulu
status=2
--- sort repeated standard input ---
alpha
delta
--- paste multiple files with a missing operand ---
1:1: error: paste: cannot read 'missing.txt': No such file or directory.
     1 |  koshkit paste -d , sort-a.txt missing.txt sort-b.txt; printf "status=%s\n" "$?"
       |  ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
zulu,,middle
alpha,,beta
status=1
--- paste repeated standard input ---
left,
right,
--- pr merge with a missing operand ---
1:1: error: pr: cannot read 'missing.txt': No such file or directory.
     1 |  koshkit pr -t -m -s , sort-a.txt missing.txt sort-b.txt; printf "status=%s\n" "$?"
       |  ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
zulu,middle
alpha,beta
status=1
--- pr merge suppresses a missing warning ---
zulu,middle
alpha,beta
status=1
--- grep an ---
banana
--- grep -v apple ---
banana
cherry
--- grep -i APPLE ---
apple
apple
--- grep stdin ---
plum
--- grep multiple files ---
pear.txt:pear
--- tr to lower ---
abc
--- tr -d digits ---
abc
