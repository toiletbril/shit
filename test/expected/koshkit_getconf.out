[CompoundList]
  [CompoundListCondition, None]
    [Assign system_status=0]
  [CompoundListCondition, None]
    [ForLoop "variable"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "koshkit" "getconf" "$variable"]
        [CompoundListCondition, ||]
          [Assign system_status=1]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "getconf-system=$system_status"]
  [CompoundListCondition, None]
    [Assign capability_status=0]
  [CompoundListCondition, None]
    [ForLoop "variable"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "koshkit" "getconf" "$variable"]
        [CompoundListCondition, ||]
          [Assign capability_status=1]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "getconf-capability=$capability_status"]
  [CompoundListCondition, None]
    [SimpleCommand "[" "$(koshkit getconf POSIX2_C_BIND)" "=" "$(koshkit getconf _POSIX2_C_BIND)" "]"]
  [CompoundListCondition, &&]
    [SimpleCommand "[" "$(koshkit getconf XOPEN_UUCP)" "=" "$(koshkit getconf _XOPEN_UUCP)" "]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "getconf-alias=$?"]
  [CompoundListCondition, None]
    [Assign path_status=0]
  [CompoundListCondition, None]
    [ForLoop "variable"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "koshkit" "getconf" "$variable" "."]
        [CompoundListCondition, ||]
          [Assign path_status=1]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "getconf-path=$path_status"]
[Word
  Unquoted "system_status=0"
]
