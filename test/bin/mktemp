#!/bin/sh

is_directory=0
template=
while [ "$#" -gt 0 ]; do
    case $1 in
        -d)
            is_directory=1
            ;;
        -t)
            shift
            template=${1-}
            ;;
        --)
            shift
            template=${1-}
            break
            ;;
        -*)
            exit 1
            ;;
        *)
            template=$1
            ;;
    esac
    shift
done

workspace=${TEST_TEMP_DIRECTORY:-.test-work}
candidate_directory=$workspace
candidate_prefix=temp-
case $template in
    */*)
        candidate_directory=${template%/*}
        candidate_name=${template##*/}
        candidate_prefix=${candidate_name%XXXXXX}
        ;;
    ?*)
        candidate_prefix=${template%XXXXXX}
        candidate_prefix=${candidate_prefix%XXX}
        ;;
esac

mkdir -p "$workspace" "$candidate_directory" || exit 1

attempt_count=0
while [ "$attempt_count" -lt 100 ]; do
    candidate="$candidate_directory/$candidate_prefix${PPID-0}-$$-$attempt_count"
    if [ "$is_directory" -eq 1 ]; then
        if mkdir "$candidate" 2>/dev/null; then
            candidate_name=${candidate##*/}
            candidate_directory=${candidate%/*}
            printf '%s/%s\n' "$(cd "$candidate_directory" && pwd)" "$candidate_name"
            exit 0
        fi
    elif ( set -C; : > "$candidate" ) 2>/dev/null; then
        candidate_name=${candidate##*/}
        candidate_directory=${candidate%/*}
        printf '%s/%s\n' "$(cd "$candidate_directory" && pwd)" "$candidate_name"
        exit 0
    fi
    attempt_count=$((attempt_count + 1))
done

exit 1
