#!/bin/env shit
start=$PWD
shitbox mkdir -p "$TEST_TEMP_DIRECTORY/cd-fail-file"
: > "$TEST_TEMP_DIRECTORY/cd-fail-file/target"
"$BIN" -c 'cd "$TEST_TEMP_DIRECTORY/cd-fail-file/target"' 2>/dev/null
echo "after rc=$?"
test "$PWD" = "$start" && echo "cwd=unchanged"
shitbox unlink "$TEST_TEMP_DIRECTORY/cd-fail-file/target"
