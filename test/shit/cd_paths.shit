#!/bin/env shit
start=$PWD
shitbox mkdir -p .test-work/cd-paths/parent/child
cd .test-work/cd-paths/parent/child
shitbox basename "$PWD"
cd ..
shitbox basename "$PWD"
cd - > ../cd-output
shitbox basename "$PWD"
cd ../..
CDPATH="$TEST_PATH_SEPARATOR" cd parent > cd-output
echo "cdpath=$?"
cd "$start"
cd .test-work/nonexistent-xyz-dir 2>&-
echo "miss=$?"
