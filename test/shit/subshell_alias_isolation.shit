#!/bin/env shit
( alias sub_only='echo hi' )
if alias | shitbox grep '^alias sub_only=' >/dev/null; then echo "leaked from subshell"; else echo "isolated from subshell"; fi
cs=$( alias cs_only='echo hi'; echo defined-inside )
echo "cmdsub reported: $cs"
if alias | shitbox grep '^alias cs_only=' >/dev/null; then echo "leaked from cmdsub"; else echo "isolated from cmdsub"; fi
