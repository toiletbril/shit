#!/bin/env shit
command -v echo
command -v set
d=$TEST_TEMP_DIRECTORY/command-v-fixture
shitbox mkdir -p "$d"
probe_file=$d/probe
if [ "${OS-}" = Windows_NT ]; then probe_file=$probe_file.exe; fi
shitbox cp "$BIN" "$probe_file"
PATH=$d
probe() { echo function_probe; }
command -v probe
shitbox rm -rf "$d"
